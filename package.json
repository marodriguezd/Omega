{
  "name": "omega",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "desktopName": "Omega",
  "author": "marodriguezd",
  "license": "MIT",
  "homepage": "https://github.com/marodriguezd/Omega",
  "repository": {
    "type": "git",
    "url": "https://github.com/marodriguezd/Omega.git"
  },
  "description": "Omega — Conscious Breathwork & Cold Adaptation Hub (React + Capacitor + Electron)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "node tests/runner.js",
    "test:platform": "node tests/runner-platform.js",
    "test:release": "node tests/runner-release.js",
    "validate": "node scripts/validate-build.mjs",
    "icons": "python3 scripts/generate-icons.py",
    "release:meta": "node scripts/release-meta.mjs",
    "checksums": "node scripts/make-checksums.mjs",
    "cap:sync": "cap sync android",
    "cap:open": "cap open android",
    "android:sync": "pnpm run build && cap sync android",
    "android:build": "pnpm run android:sync && ./android/gradlew -p android assembleRelease",
    "android:apk": "pnpm run android:build",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "tsc -b && vite build && electron-builder --publish never",
    "electron:pack": "tsc -b && vite build && electron-builder --dir --publish never",
    "electron:preview": "tsc -b && vite build && electron .",
    "dist:mac": "tsc -b && vite build && electron-builder --mac dmg --publish never",
    "dist:win": "tsc -b && vite build && electron-builder --win msi --publish never",
    "dist:linux": "tsc -b && vite build && electron-builder --linux AppImage --publish never",
    "dist:all": "tsc -b && vite build && electron-builder --mac dmg --win msi --linux AppImage --publish never"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/haptics": "^8.0.2",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^10.0.5",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "typescript": "~5.8.2",
    "vite": "^6.4.3",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.marodriguezd.omega",
    "productName": "Omega",
    "copyright": "Copyright © 2026 marodriguezd",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.healthcare-fitness",
      "icon": "build/icon.icns",
      "artifactName": "Omega-${version}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "msi",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "executableName": "Omega",
      "artifactName": "Omega-${version}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icons/512x512.png",
      "executableName": "Omega",
      "syncDesktopName": true,
      "category": "Health",
      "artifactName": "Omega-${version}.${ext}"
    },
    "dmg": {
      "artifactName": "Omega-${version}.${ext}"
    },
    "msi": {
      "artifactName": "Omega-${version}.${ext}"
    }
  }
}
